<?xml version="1.0" encoding="utf-8"?>
<!-- Sample text doubles as the Android 12+ widget picker preview;
     DateWidgetProvider replaces all of it. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/widget_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/widget_background"
        android:tint="#FF121214" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="8dp">

        <TextView
            android:id="@+id/date_weekday"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:text="शुक्रबार"
            android:textColor="#FFEFECE6"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/date_day"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="२७"
            android:textColor="#FFEFECE6"
            android:textSize="42sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/date_month"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:text="कात्तिक २०८३"
            android:textColor="#FFFFD700"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/date_ad"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:text="Fri, 13 Nov 2026"
            android:textColor="#9EEFECE6"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/date_tithi"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:singleLine="true"
            android:text="कृष्ण त्रयोदशी"
            android:textColor="#FFFFD700"
            android:textSize="11sp" />
    </LinearLayout>
</FrameLayout>
