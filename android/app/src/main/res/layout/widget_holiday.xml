<?xml version="1.0" encoding="utf-8"?>
<!-- Sample text doubles as the Android 12+ widget picker preview;
     HolidayWidgetProvider replaces all of it. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/widget_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/widget_background"
        android:tint="#FF121214" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/widget_padding"
        android:paddingVertical="6dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:minWidth="56dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/holiday_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="५"
                android:textColor="#FFFF6E61"
                android:textSize="30sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/holiday_unit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:text="days"
                android:textColor="#9EEFECE6"
                android:textSize="10sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/holiday_divider"
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:layout_marginHorizontal="10dp"
            android:layout_marginVertical="4dp"
            android:importantForAccessibility="no"
            android:scaleType="fitXY"
            android:src="@drawable/widget_solid"
            android:tint="#24EFECE6" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/holiday_caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:letterSpacing="0.08"
                android:singleLine="true"
                android:text="@string/widget_next_holiday"
                android:textColor="#9EEFECE6"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/holiday_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:singleLine="true"
                android:text="Tihar"
                android:textColor="#FFEFECE6"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/holiday_date"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:singleLine="true"
                android:text="बुधबार, २ मंसिर · 18 Nov"
                android:textColor="#9EEFECE6"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
